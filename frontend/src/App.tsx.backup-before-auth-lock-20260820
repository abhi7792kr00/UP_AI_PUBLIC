import { Routes, Route, Navigate } from "react-router-dom";

import { PublicLayout } from "./layouts/PublicLayout";
import { DashboardLayout } from "./layouts/DashboardLayout";
import { CitizenLayout } from "./layouts/CitizenLayout";

import { ProtectedRoute } from "./features/auth/guards/ProtectedRoute";
import { RoleGuard } from "./features/auth/guards/RoleGuard";

import { Home } from "./pages/Home";
import { TrackComplaint } from "./pages/TrackComplaint";
import { Complaints } from "./pages/Complaints";
import { ComplaintDetails } from "./pages/ComplaintDetails";
import { NewComplaint } from "./pages/NewComplaint";
import { Officers } from "./pages/Officers";
import { OfficerProfile } from "./pages/OfficerProfile";
import { Departments } from "./pages/Departments";
import { AIPage } from "./pages/AIPage";
import { Dashboard } from "./pages/Dashboard";
import { Analytics } from "./pages/Analytics";

import { CitizenLogin } from "./pages/auth/CitizenLogin";
import CitizenDashboard from "./pages/citizen/CitizenDashboard";
import CitizenComplaints from "./pages/citizen/CitizenComplaints";
import CitizenComplaintDetails from "./pages/CitizenComplaintDetails";

import { Unauthorized } from "./pages/Unauthorized";

export default function App() {
  return (
    <Routes>

      {/* =====================================================
          PUBLIC
      ====================================================== */}

      <Route element={<PublicLayout />}>
        <Route path="/" element={<Navigate to="/login/citizen" replace />} />

        <Route
          path="/track"
          element={<TrackComplaint />}
        />

        <Route
          path="/officers"
          element={<Officers />}
        />

        <Route
          path="/officers/:id"
          element={<OfficerProfile />}
        />

        <Route
          path="/departments"
          element={<Departments />}
        />

        <Route
          path="/ai"
          element={<AIPage />}
        />

        {/* Citizen Login */}
        <Route
          path="/login/citizen"
          element={<CitizenLogin />}
        />

      </Route>


      {/* =====================================================
          AUTHENTICATED CITIZEN
          role_id = 9
      ====================================================== */}

      <Route element={<ProtectedRoute />}>
        <Route element={<RoleGuard allowedRoles={[9]} />}>
          <Route element={<CitizenLayout />}>

            <Route
              path="/citizen"
              element={<CitizenDashboard />}
            />

            <Route
              path="/citizen/complaints"
              element={<CitizenComplaints />}
            />

            <Route
              path="/citizen/complaints/new"
              element={<NewComplaint />}
            />

            <Route
              path="/citizen/complaints/:complaintNumber"
              element={<CitizenComplaintDetails />}
            />

          </Route>
        </Route>
      </Route>


      {/* =====================================================
          EXISTING DASHBOARD
          Temporarily kept intact.
      ====================================================== */}

      <Route element={<DashboardLayout />}>

        <Route
          path="/dashboard"
          element={<Dashboard />}
        />

        <Route
          path="/complaints"
          element={<Complaints />}
        />

        <Route
          path="/complaints/new"
          element={<NewComplaint />}
        />

        <Route
          path="/complaints/:id"
          element={<ComplaintDetails />}
        />

        <Route
          path="/analytics"
          element={<Analytics />}
        />

      </Route>


      {/* =====================================================
          AUTHORIZATION
      ====================================================== */}

      <Route
        path="/unauthorized"
        element={<Unauthorized />}
      />


      {/* =====================================================
          FALLBACK
      ====================================================== */}

      <Route
        path="*"
        element={<Navigate to="/" replace />}
      />

    </Routes>
  );
}
