/* =========================================================
   CITIZEN PORTAL — RESPONSIVE SLIDING SIDEBAR
   ========================================================= */

:root {
  --citizen-sidebar-expanded: 202px;
  --citizen-sidebar-collapsed: 72px;
  --citizen-topbar-height: 62px;
}

/* Prevent the whole application from creating horizontal scroll */
html,
body,
#root {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: hidden;
}

/* Main citizen shell */
.citizen-dashboard {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 100vh;
  overflow-x: hidden;
}

/* =========================================================
   TOP BAR
   ========================================================= */

.citizen-topbar {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 1000;

  width: 100%;
  height: var(--citizen-topbar-height);

  box-sizing: border-box;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.citizen-sidebar {
  position: fixed;
  z-index: 950;

  top: var(--citizen-topbar-height);
  left: 0;
  bottom: 0;

  width: var(--citizen-sidebar-collapsed);

  box-sizing: border-box;

  overflow-x: hidden;
  overflow-y: auto;

  transition:
    width 220ms ease,
    transform 220ms ease;

  scrollbar-width: thin;
}

/* Expand sidebar when mouse is over it */
.citizen-sidebar:hover {
  width: var(--citizen-sidebar-expanded);
}

/* Keep navigation content inside sidebar */
.citizen-sidebar-nav {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* Navigation items */
.citizen-nav-item {
  width: 100%;
  min-width: 0;

  box-sizing: border-box;

  display: flex;
  align-items: center;
  gap: 14px;

  white-space: nowrap;
  overflow: hidden;
}

/* Icon stays visible when collapsed */
.citizen-nav-item > svg,
.citizen-nav-item > span:first-child {
  flex: 0 0 24px;
}

/* Text disappears in collapsed state */
.citizen-sidebar:not(:hover) .citizen-nav-item > span:not(:first-child) {
  opacity: 0;
  width: 0;
  overflow: hidden;
}

/* Text comes back when expanded */
.citizen-sidebar:hover .citizen-nav-item > span:not(:first-child) {
  opacity: 1;
  width: auto;
}

/* Mobile sidebar header */
.citizen-sidebar-mobile-head {
  box-sizing: border-box;
}

/* =========================================================
   MAIN CONTENT
   ========================================================= */

.citizen-main {
  position: relative;

  box-sizing: border-box;

  width: calc(100% - var(--citizen-sidebar-collapsed));

  max-width: calc(100% - var(--citizen-sidebar-collapsed));

  min-width: 0;

  margin-left: var(--citizen-sidebar-collapsed);

  padding-top: var(--citizen-topbar-height);

  overflow-x: hidden;

  transition:
    margin-left 220ms ease,
    width 220ms ease,
    max-width 220ms ease;
}

/*
 * When sidebar is hovered, give main content enough room.
 * This prevents content from hiding underneath expanded sidebar.
 */
.citizen-sidebar:hover ~ .citizen-main {
  margin-left: var(--citizen-sidebar-expanded);

  width: calc(100% - var(--citizen-sidebar-expanded));

  max-width: calc(100% - var(--citizen-sidebar-expanded));
}

/* Every direct child must be shrinkable */
.citizen-main > * {
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

/* =========================================================
   COMPLAINT / PAGE CONTENT SAFETY
   ========================================================= */

.citizen-main .page,
.citizen-main .page-header,
.citizen-main .form-layout,
.citizen-main .form-card,
.citizen-main .card {
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

/* Prevent oversized grids from creating horizontal scroll */
.citizen-main .form-layout {
  width: 100%;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 900px) {

  .citizen-sidebar {
    width: 260px;

    transform: translateX(-100%);

    box-shadow: 12px 0 30px rgba(0, 0, 0, 0.18);
  }

  .citizen-sidebar.is-open {
    transform: translateX(0);
  }

  .citizen-sidebar:hover {
    width: 260px;
  }

  .citizen-sidebar:not(:hover) .citizen-nav-item > span:not(:first-child),
  .citizen-sidebar:hover .citizen-nav-item > span:not(:first-child) {
    opacity: 1;
    width: auto;
  }

  .citizen-main,
  .citizen-sidebar:hover ~ .citizen-main {
    width: 100%;
    max-width: 100%;
    margin-left: 0;
  }

  .citizen-sidebar-overlay {
    position: fixed;
    inset: var(--citizen-topbar-height) 0 0 0;

    z-index: 940;

    display: block;

    background: rgba(10, 5, 35, 0.35);

    border: 0;
    padding: 0;
  }

  .citizen-mobile-menu {
    display: inline-flex;
  }

  .citizen-main .form-layout {
    grid-template-columns: minmax(0, 1fr);
  }
}

/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 600px) {

  :root {
    --citizen-topbar-height: 58px;
  }

  .citizen-topbar {
    height: var(--citizen-topbar-height);
  }

  .citizen-main {
    padding-top: var(--citizen-topbar-height);
  }

  .citizen-main .page {
    padding-left: 14px;
    padding-right: 14px;
  }
}

/* =========================================================
   REMOVE HORIZONTAL SCROLLBAR
   ========================================================= */

.citizen-dashboard,
.citizen-main,
.citizen-main > *,
.citizen-main .form-layout {
  overflow-x: clip;
}


/* =========================================================
   FINAL CITIZEN DASHBOARD WIDTH / GRID FIX
   Prevent right column from escaping viewport
   ========================================================= */

.citizen-main {
  width: calc(100% - var(--citizen-sidebar-collapsed));
  max-width: calc(100% - var(--citizen-sidebar-collapsed));
  min-width: 0;
  box-sizing: border-box;
  overflow-x: hidden;
}

.citizen-sidebar:hover ~ .citizen-main {
  width: calc(100% - var(--citizen-sidebar-expanded));
  max-width: calc(100% - var(--citizen-sidebar-expanded));
  margin-left: var(--citizen-sidebar-expanded);
}

/* Main dashboard two-column area */
.citizen-content-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(280px, 330px);

  width: 100%;
  max-width: 100%;
  min-width: 0;

  box-sizing: border-box;

  gap: 18px;

  overflow: hidden;
}

/* Left side */
.citizen-primary-column {
  min-width: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* Right side */
.citizen-right-column {
  min-width: 0;
  width: 100%;
  max-width: 330px;
  box-sizing: border-box;

  overflow: hidden;
}

/* Cards inside right column */
.citizen-right-column > *,
.citizen-right-column .citizen-card {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* Prevent tables/content from forcing parent wider */
.citizen-primary-column,
.citizen-primary-column > *,
.citizen-card,
.citizen-section-heading,
.citizen-stat-grid,
.citizen-action-row {
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

/* Recent complaints table */
.citizen-card {
  overflow: hidden;
}

/* =========================================================
   TABLE RESPONSIVENESS
   ========================================================= */

.citizen-card table {
  width: 100%;
  max-width: 100%;
  table-layout: fixed;
}

.citizen-card th,
.citizen-card td {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* =========================================================
   MEDIUM SCREEN
   ========================================================= */

@media (max-width: 1150px) {

  .citizen-content-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .citizen-right-column {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 16px;

