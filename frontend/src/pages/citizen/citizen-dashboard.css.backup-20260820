/* ============================================================
   CITIZEN PORTAL — SIDEBAR / MAIN ALIGNMENT FINAL FIX
   ============================================================ */

:root {
  --citizen-sidebar-expanded: 174px;
  --citizen-sidebar-collapsed: 62px;
  --citizen-topbar-height: 62px;
}

/* ------------------------------------------------------------
   ROOT
   ------------------------------------------------------------ */

html,
body,
#root {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  overflow-x: hidden !important;
}

.citizen-dashboard {
  width: 100% !important;
  max-width: 100vw !important;
  min-width: 0 !important;
  overflow-x: hidden !important;
  box-sizing: border-box !important;
}

/* ------------------------------------------------------------
   TOPBAR
   ------------------------------------------------------------ */

.citizen-topbar {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;

  width: 100% !important;
  height: var(--citizen-topbar-height) !important;

  z-index: 1000 !important;

  box-sizing: border-box !important;
}

/* ------------------------------------------------------------
   SIDEBAR
   ------------------------------------------------------------ */

.citizen-sidebar {
  position: fixed !important;

  top: var(--citizen-topbar-height) !important;
  left: 0 !important;
  bottom: 0 !important;

  width: var(--citizen-sidebar-expanded) !important;
  max-width: var(--citizen-sidebar-expanded) !important;
  min-width: var(--citizen-sidebar-expanded) !important;

  z-index: 900 !important;

  box-sizing: border-box !important;

  overflow-x: hidden !important;
  overflow-y: auto !important;

  transition:
    width 0.22s ease,
    min-width 0.22s ease,
    max-width 0.22s ease !important;
}

/* ------------------------------------------------------------
   COLLAPSED SIDEBAR
   Supports the common class/state names already used by
   citizen layouts.
   ------------------------------------------------------------ */

.citizen-sidebar.collapsed,
.citizen-sidebar.is-collapsed,
.citizen-sidebar[data-collapsed="true"],
.citizen-sidebar[aria-expanded="false"] {
  width: var(--citizen-sidebar-collapsed) !important;
  max-width: var(--citizen-sidebar-collapsed) !important;
  min-width: var(--citizen-sidebar-collapsed) !important;
}

/* ------------------------------------------------------------
   MAIN CONTENT

   IMPORTANT:
   Main must start AFTER the sidebar.
   ------------------------------------------------------------ */

.citizen-main {
  position: relative !important;

  margin-left: var(--citizen-sidebar-expanded) !important;

  width: calc(
    100% - var(--citizen-sidebar-expanded)
  ) !important;

  max-width: calc(
    100% - var(--citizen-sidebar-expanded)
  ) !important;

  min-width: 0 !important;

  padding-top: var(--citizen-topbar-height) !important;

  box-sizing: border-box !important;

  overflow-x: hidden !important;

  transition:
    margin-left 0.22s ease,
    width 0.22s ease,
    max-width 0.22s ease !important;
}

/* Main when sidebar is collapsed */

.citizen-sidebar.collapsed ~ .citizen-main,
.citizen-sidebar.is-collapsed ~ .citizen-main,
.citizen-sidebar[data-collapsed="true"] ~ .citizen-main,
.citizen-sidebar[aria-expanded="false"] ~ .citizen-main {
  margin-left: var(--citizen-sidebar-collapsed) !important;

  width: calc(
    100% - var(--citizen-sidebar-collapsed)
  ) !important;

  max-width: calc(
    100% - var(--citizen-sidebar-collapsed)
  ) !important;
}

