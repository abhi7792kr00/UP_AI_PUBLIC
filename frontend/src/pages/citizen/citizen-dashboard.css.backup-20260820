/* UP_AI Citizen Dashboard
   Pixel-oriented responsive implementation based on the supplied reference UI.
   Keep component-specific CSS here so it is easy to maintain/replace later.
*/

:root {
  --citizen-navy: #07194d;
  --citizen-navy-2: #0b236b;
  --citizen-blue: #1769ff;
  --citizen-blue-2: #2b76f4;
  --citizen-text: #14224c;
  --citizen-muted: #7080a5;
  --citizen-border: #dbe5f5;
  --citizen-bg: #f4f8ff;
  --citizen-card: #ffffff;
  --citizen-green: #0b9b57;
  --citizen-orange: #ee9a13;
  --citizen-shadow: 0 8px 25px rgba(20, 52, 110, 0.07);
}

.citizen-dashboard {
  min-height: 100vh;
  background: var(--citizen-bg);
  color: var(--citizen-text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.citizen-dashboard button,
.citizen-dashboard input {
  font: inherit;
}

.citizen-dashboard button {
  cursor: pointer;
}

.citizen-topbar {
  position: sticky;
  top: 0;
  z-index: 50;
  height: 70px;
  padding: 0 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
  background: linear-gradient(100deg, #061645 0%, #0b2168 58%, #091b59 100%);
  box-shadow: 0 2px 12px rgba(2, 14, 54, 0.2);
}

.citizen-brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.citizen-emblem {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,.5);
  background: rgba(255,255,255,.08);
}

.citizen-brand-copy > div {
  display: flex;
  align-items: center;
  gap: 9px;
  line-height: 1;
}

.citizen-brand-copy strong {
  font-size: 28px;
  letter-spacing: -.7px;
}

.citizen-brand-copy .portal-name {
  font-size: 24px;
  font-weight: 500;
}

.brand-divider {
  opacity: .6;
  font-size: 23px;
}

.citizen-brand-copy small {
  display: block;
  margin-top: 5px;
  color: rgba(255,255,255,.8);
  font-size: 12px;
}

.citizen-topbar-actions {
  display: flex;
  align-items: center;
  gap: 13px;
}

.citizen-icon-button,
.citizen-language-button,
.citizen-user-menu,
.citizen-mobile-menu {
  border: 1px solid rgba(255,255,255,.16);
  background: rgba(255,255,255,.07);
  color: #fff;
}

.citizen-icon-button {
  position: relative;
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 12px;
}

.notification-button span {
  position: absolute;
  top: -3px;
  right: -2px;
  min-width: 20px;
  height: 20px;
  padding: 0 5px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: #f23c4c;
  font-size: 11px;
  font-weight: 800;
}

.citizen-language-button {
  height: 43px;
  padding: 0 13px;
  display: flex;
  align-items: center;
  gap: 7px;
  border-radius: 11px;
  font-size: 14px;
}

.citizen-user-menu {
  min-width: 160px;
  height: 47px;
  padding: 4px 9px 4px 6px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-radius: 12px;
  text-align: left;
}

.citizen-user-menu img,
.citizen-avatar {
  width: 37px;
  height: 37px;
  flex: 0 0 37px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #eef4ff, #d9e5ff);
  color: #2b68df;
  object-fit: cover;
}

.citizen-user-menu > span:nth-child(2) {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.citizen-user-menu strong {
  font-size: 13px;
  white-space: nowrap;
}

.citizen-user-menu small {
  margin-top: 2px;
  opacity: .72;
  font-size: 11px;
}

.citizen-mobile-menu {
  display: none;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 10px;
}

.citizen-sidebar {
  position: fixed;
  top: 70px;
  bottom: 0;
  left: 0;
  z-index: 40;
  width: 235px;
  padding: 17px 12px;
  background: linear-gradient(180deg, #0b276f 0%, #07184d 100%);
  color: #fff;
}

.citizen-sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.citizen-nav-item {
  width: 100%;
  min-height: 47px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  gap: 15px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: rgba(255,255,255,.93);
  text-decoration: none;
  font-size: 15px;
  text-align: left;
  transition: background .16s ease, transform .16s ease;
}

.citizen-nav-item:hover {
  background: rgba(255,255,255,.08);
}

.citizen-nav-item.active {
  background: linear-gradient(90deg, #1a61d9, #1951c4);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
}

.citizen-nav-with-badge .nav-icon-wrap {
  position: relative;
  display: inline-flex;
}

.citizen-nav-with-badge b {
  position: absolute;
  top: -8px;
  right: -10px;
  min-width: 18px;
  height: 18px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #f13c4c;
  font-size: 10px;
}

.citizen-logout {
  margin-top: 7px;
}

.citizen-sidebar-mobile-head {
  display: none;
}

.citizen-main {
  margin-left: 235px;
  padding: 20px 28px 30px;
}

.citizen-welcome {
  min-height: 182px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28px 36px;
  border: 1px solid #d6e3f8;
  border-radius: 16px;
  background: linear-gradient(105deg, #e9f3ff 0%, #eef7ff 55%, #f8fbff 100%);
  box-shadow: var(--citizen-shadow);
}

.citizen-welcome-copy {
  position: relative;
  z-index: 2;
}

.citizen-welcome h1 {
  margin: 0;
  font-size: 31px;
  letter-spacing: -.7px;
}

.citizen-welcome h1 span {
  font-size: 28px;
}

.citizen-welcome h2 {
  margin: 4px 0 4px;
  font-size: 22px;
  font-weight: 500;
}

.citizen-welcome p {
  margin: 0;
  color: #314878;
  font-size: 14px;
}

.citizen-welcome-art {
  position: absolute;
  right: 10px;
  bottom: -42px;
  width: 380px;
  height: 230px;
  color: rgba(70, 136, 239, .13);
  font-size: 145px;
}

.art-dome {
  position: absolute;
  right: 160px;
  bottom: 0;
}

.art-building {
  position: absolute;
  right: 10px;
  bottom: -10px;
  font-size: 210px;
}

.art-building.small {
  right: 290px;
  bottom: 5px;
  font-size: 100px;
}

.citizen-content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 382px;
  gap: 18px;
  margin-top: 18px;
}

.citizen-primary-column,
.citizen-right-column {
  min-width: 0;
}

.citizen-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.citizen-stat-card,
.citizen-card {
  border: 1px solid var(--citizen-border);
  background: var(--citizen-card);
  border-radius: 15px;
  box-shadow: var(--citizen-shadow);
}

.citizen-stat-card {
  min-height: 135px;
  padding: 18px 16px;
  display: flex;
  gap: 14px;
}

.stat-icon {
  width: 45px;
  height: 45px;
  flex: 0 0 45px;
  display: grid;
  place-items: center;
  border-radius: 13px;
}

.stat-blue {
  color: #1961e8;
  background: #e7f0ff;
}

.stat-orange {
  color: #ee9710;
  background: #fff0d7;
}

.stat-green {
  color: #078f50;
  background: #dcf6e9;
}

.citizen-stat-card > div:last-child {
  min-width: 0;
}

.citizen-stat-card span {
  display: block;
  font-size: 14px;
  color: #1c2b52;
}

.citizen-stat-card strong {
  display: block;
  margin: 5px 0;
  font-size: 29px;
  line-height: 1;
}

.citizen-stat-card small {
  display: block;
  color: #7b89a9;
  font-size: 11px;
  line-height: 1.35;
}

.citizen-action-row {
  display: grid;
  grid-template-columns: 1.45fr 1fr 1fr;
  gap: 16px;
  margin: 18px 0 22px;
}

.citizen-primary-action,
.citizen-secondary-action {
  height: 59px;
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  font-weight: 700;
  font-size: 15px;
}

.citizen-primary-action {
  border: 0;
  color: #fff;
  background: linear-gradient(105deg, #1b66ff, #1c5ce7);
  box-shadow: 0 7px 17px rgba(23, 105, 255, .19);
}

.citizen-secondary-action {
  color: #14295c;
  border: 1px solid #cddcf6;
  background: #fff;
}

.citizen-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.citizen-section-heading h2 {
  margin: 0;
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 17px;
}

.citizen-section-heading > button,
.notification-card .citizen-section-heading button {
  border: 0;
  background: transparent;
  color: #1762e4;
  font-weight: 700;
  font-size: 12px;
  display: inline-flex;
  align-items: center;
  gap: 2px;
}

.complaints-card {
  padding: 16px 18px 8px;
}

.complaints-table-wrap {
  margin-top: 12px;
  overflow-x: auto;
}

.complaints-table {
  width: 100%;
  min-width: 700px;
  border-collapse: separate;
  border-spacing: 0;
  overflow: hidden;
}

.complaints-table thead th {
  padding: 12px 10px;
  color: #1d2b55;
  background: #f2f6fd;
  font-size: 12px;
  font-weight: 700;
  text-align: left;
}

.complaints-table thead th:first-child {
  border-radius: 9px 0 0 9px;
}

.complaints-table thead th:last-child {
  border-radius: 0 9px 9px 0;
}

.complaints-table tbody tr {
  cursor: pointer;
  transition: background .14s ease;
}

.complaints-table tbody tr:hover {
  background: #f7faff;
}

.complaints-table td {
  height: 57px;
  padding: 8px 10px;
  border-bottom: 1px solid #e4ebf7;
  color: #2a3a62;
  font-size: 12px;
  white-space: nowrap;
}

.complaints-table td:first-child strong {
  color: #182d60;
  font-size: 12px;
}

.complaints-table td:nth-child(2) {
  display: flex;
  align-items: center;
  gap: 8px;
}

.complaint-category-icon {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 9px;
}

.complaint-category-icon.electricity {
  color: #ffb200;
  background: #fff1cf;
}

.complaint-category-icon.road {
  color: #315aa8;
  background: #e9effb;
}

.complaint-category-icon.water {
  color: #1685ef;
  background: #e7f4ff;
}

.complaint-category-icon.revenue {
  color: #4d679c;
  background: #edf1f8;
}

.complaint-category-icon.health {
  color: #f04467;
  background: #ffe8ee;
}

.citizen-dashboard-emoji {
  font-size: 17px;
}

.complaint-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.complaint-status i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
}

.status-progress {
  color: #1b5ddc;
  background: #e7f0ff;
}

.status-resolved {
  color: #168c4e;
  background: #ddf6e9;
}

.status-pending {
  color: #d88a05;
  background: #fff0d7;
}

.citizen-right-column {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.notification-card {
  padding: 17px 14px 12px;
}

.notification-list {
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.notification-item {
  position: relative;
  min-height: 66px;
  display: flex;
  gap: 10px;
  padding: 9px 10px;
  border: 1px solid #e5ebf5;
  border-radius: 11px;
  background: #fbfdff;
}

.notification-icon {
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  display: grid;
  place-items: center;
  border-radius: 9px;
}

.notification-icon.blue {
  color: #1967e8;
  background: #e7f0ff;
}

.notification-icon.orange {
  color: #e7910d;
  background: #fff0d8;
}

.notification-icon.green {
  color: #0c9653;
  background: #ddf5e8;
}

.notification-item > div {
  min-width: 0;
}

.notification-item strong {
  display: block;
  color: #172653;
  font-size: 11px;
  line-height: 1.4;
  font-weight: 700;
}

.notification-item small {
  display: block;
  margin-top: 3px;
  color: #8490aa;
  font-size: 10px;
}

.notification-unread {
  position: absolute;
  right: 9px;
  top: 13px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #1666e8;
}

.ai-card {
  padding: 17px 15px 14px;
}

.ai-card-heading,
.voice-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-card-heading h2,
.voice-heading h2 {
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 16px;
}

.ai-card-heading > svg {
  color: #226cff;
}

.ai-message {
  margin: 13px 0;
  padding: 12px 13px;
  border-radius: 13px;
  background: linear-gradient(135deg, #edf4ff, #e1edff);
  color: #21345f;
  font-size: 12px;
  line-height: 1.65;
}

.ai-input-row {
  display: flex;
  gap: 6px;
}

.ai-input-row input {
  min-width: 0;
  flex: 1;
  height: 39px;
  padding: 0 12px;
  border: 1px solid #cbdcf7;
  border-radius: 10px;
  outline: none;
  color: #26385e;
  background: #fff;
  font-size: 11px;
}

.ai-input-row input:focus {
  border-color: #4e83ef;
  box-shadow: 0 0 0 3px rgba(49, 112, 234, .1);
}

.ai-input-row button {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 10px;
  color: #fff;
  background: #246be7;
}

.ai-suggestions {
  display: flex;
  gap: 6px;
  margin-top: 8px;
  overflow-x: auto;
}

.ai-suggestions button {
  flex: 0 0 auto;
  padding: 7px 9px;
  border: 1px solid #cbdcf7;
  border-radius: 999px;
  color: #38517d;
  background: #f8fbff;
  font-size: 9px;
}

.voice-card {
  min-height: 180px;
  padding: 17px 15px 14px;
  border-color: #d4eedf;
  background: linear-gradient(145deg, #f2fff8, #eafbf3);
}

.voice-heading {
  align-items: flex-start;
}

.voice-heading h2 {
  color: #126a48;
}

.voice-heading span {
  margin-top: 24px;
  color: #396f5b;
  font-size: 10px;
}

.voice-visualizer {
  height: 78px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.voice-visualizer > span {
  width: 3px;
  border-radius: 4px;
  background: #4fca8c;
  animation: voice-bars 1.1s ease-in-out infinite alternate;
}

.voice-visualizer > span:nth-child(1),
.voice-visualizer > span:nth-child(8) { height: 12px; }
.voice-visualizer > span:nth-child(2),
.voice-visualizer > span:nth-child(7) { height: 23px; animation-delay: .15s; }
.voice-visualizer > span:nth-child(3),
.voice-visualizer > span:nth-child(6) { height: 35px; animation-delay: .25s; }
.voice-visualizer > span:nth-child(4),
.voice-visualizer > span:nth-child(5) { height: 48px; animation-delay: .35s; }

.voice-visualizer button {
  width: 58px;
  height: 58px;
  margin: 0 5px;
  display: grid;
  place-items: center;
  border: 7px solid #a8edc9;
  border-radius: 50%;
  color: #fff;
  background: #10ad63;
  box-shadow: 0 4px 15px rgba(10, 153, 82, .2);
}

.voice-card p {
  margin: 0;
  text-align: center;
  color: #39725c;
  font-size: 10px;
}

@keyframes voice-bars {
  to { transform: scaleY(.55); opacity: .7; }
}

.citizen-notification-popover {
  position: fixed;
  z-index: 80;
  top: 64px;
  right: 170px;
  width: 365px;
  padding: 12px;
  border: 1px solid #d8e3f5;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 18px 45px rgba(18, 41, 87, .2);
}

.citizen-popover-title {
  padding: 5px 5px 10px;
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid #e7edf7;
}

.citizen-popover-title button {
  border: 0;
  background: transparent;
}

.citizen-popover-item {
  display: flex;
  gap: 9px;
  padding: 11px 4px;
}

.citizen-popover-item strong {
  display: block;
  font-size: 11px;
  line-height: 1.4;
}

.citizen-popover-item small {
  display: block;
  margin-top: 3px;
  color: #8490aa;
  font-size: 10px;
}

.notification-dot {
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  margin-top: 5px;
  border-radius: 50%;
}

.notification-dot.blue { background: #216cf0; }
.notification-dot.orange { background: #ee9711; }
.notification-dot.green { background: #0c9954; }

.citizen-sidebar-overlay {
  display: none;
}

.citizen-help {
  position: fixed;
  right: 18px;
  bottom: 16px;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 9px 12px;
  border: 1px solid #d7e2f4;
  border-radius: 999px;
  color: #35527f;
  background: rgba(255,255,255,.95);
  box-shadow: 0 5px 18px rgba(15, 44, 94, .1);
  font-size: 11px;
}

@media (max-width: 1250px) {
  .citizen-content-grid {
    grid-template-columns: 1fr;
  }

  .citizen-right-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .voice-card {
    grid-column: span 2;
  }

  .citizen-stat-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .citizen-topbar {
    height: 64px;
    padding: 0 15px;
  }

  .citizen-brand-copy .portal-name,
  .brand-divider {
    display: none;
  }

  .citizen-brand-copy strong {
    font-size: 22px;
  }

  .citizen-sidebar {
    top: 64px;
    transform: translateX(-100%);
    transition: transform .22s ease;
  }

  .citizen-sidebar.is-open {
    transform: translateX(0);
  }

  .citizen-sidebar-mobile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 3px 7px 16px;
  }

  .citizen-sidebar-mobile-head button {
    border: 0;
    color: #fff;
    background: transparent;
  }

  .citizen-mobile-menu {
    display: grid;
  }

  .citizen-sidebar-overlay {
    position: fixed;
    inset: 64px 0 0;
    z-index: 35;
    display: block;
    border: 0;
    background: rgba(3, 16, 48, .45);
  }

  .citizen-main {
    margin-left: 0;
    padding: 15px;
  }

  .citizen-welcome {
    min-height: 165px;
    padding: 24px;
  }

  .citizen-welcome-art {
    opacity: .6;
  }

  .citizen-right-column {
    grid-template-columns: 1fr;
  }

  .voice-card {
    grid-column: auto;
  }

  .citizen-language-button {
    display: none;
  }

  .citizen-notification-popover {
    right: 10px;
  }
}

@media (max-width: 600px) {
  .citizen-topbar {
    padding: 0 10px;
  }

  .citizen-emblem {
    width: 37px;
    height: 37px;
  }

  .citizen-brand-copy strong {
    font-size: 19px;
  }

  .citizen-brand-copy small {
    font-size: 9px;
  }

  .citizen-user-menu {
    min-width: 0;
    width: 44px;
    padding: 3px;
  }

  .citizen-user-menu > span:nth-child(2),
  .citizen-user-menu > svg {
    display: none;
  }

  .citizen-welcome {
    min-height: 185px;
    padding: 20px;
  }

  .citizen-welcome h1 {
    font-size: 24px;
  }

